@page
@model SsoServer.Pages.Account.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connexion — Sso</title>

    <script>
            // Appliqué avant le premier rendu : évite le flash de thème clair.
            (function() {
                try {
                    var saved = localStorage.getItem('sso-theme');
                    var dark = saved
                        ? saved === 'dark'
                        : window.matchMedia('(prefers-color-scheme: dark)').matches;
                    if (dark) document.documentElement.setAttribute('data-theme', 'dark');
                } catch (e) { }
            })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />

    <style>
            :root {
                --paper: #F3F6F5;
                --card: #FFFFFF;
                --ink: #10231F;
                --ink-soft: #47605B;
                --muted: #7B8D89;
                --line: #DDE5E3;
                --line-soft: #E9EFEE;
                --accent: #0E7C7B;
                --accent-deep: #0A5654;
                --accent-ring: rgba(14, 124, 123, 0.14);
                --alert: #A33A2E;
                --alert-wash: #FBEDEB;
                --alert-line: rgba(163, 58, 46, 0.22);
                --hover: #ECF1F0;
                --on-accent: #FFFFFF;
                --display: 'Newsreader', Georgia, serif;
                --body: 'Inter', system-ui, -apple-system, sans-serif;
                --mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
                color-scheme: light;
            }

            html[data-theme='dark'] {
                --paper: #0C1513;
                --card: #131F1D;
                --ink: #E3EDEA;
                --ink-soft: #9FB3AE;
                --muted: #728682;
                --line: #24322F;
                --line-soft: #1B2725;
                --accent: #2FA8A3;
                --accent-deep: #46BDB7;
                --accent-ring: rgba(47, 168, 163, 0.20);
                --alert: #E58A7C;
                --alert-wash: rgba(163, 58, 46, 0.13);
                --alert-line: rgba(229, 138, 124, 0.28);
                --hover: #1A2A27;
                --on-accent: #071110;
                color-scheme: dark;
            }

            * {
                box-sizing: border-box;
            }

            html {
                background: var(--paper);
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                background: var(--paper);
                color: var(--ink);
                font-family: var(--body);
                font-size: 14px;
                line-height: 1.5;
                -webkit-font-smoothing: antialiased;
                transition: background 220ms ease, color 220ms ease;
            }

            /* ---------- En-tête ---------- */
            .bar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding: 18px 26px;
            }

            .logotype {
                font-family: var(--display);
                font-size: 23px;
                font-weight: 500;
                letter-spacing: -0.015em;
                color: var(--ink);
                user-select: none;
                line-height: 1;
            }

                .logotype em {
                    font-style: normal;
                    color: var(--accent);
                }

            .theme {
                display: grid;
                place-items: center;
                width: 34px;
                height: 34px;
                border: 1px solid var(--line);
                border-radius: 9px;
                background: var(--card);
                color: var(--ink-soft);
                cursor: pointer;
                transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
            }

                .theme:hover {
                    background: var(--hover);
                    color: var(--ink);
                    border-color: var(--muted);
                }

                .theme svg {
                    display: block;
                }

                .theme .moon {
                    display: none;
                }

            html[data-theme='dark'] .theme .sun {
                display: none;
            }

            html[data-theme='dark'] .theme .moon {
                display: block;
            }

            /* ---------- Scène ---------- */
            .stage {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 32px 24px 64px;
            }

            .record {
                width: 100%;
                max-width: 384px;
            }

            h1 {
                font-family: var(--display);
                font-size: 41px;
                line-height: 1.06;
                letter-spacing: -0.025em;
                font-weight: 400;
                margin: 0 0 26px;
                text-align: center; /* ← remplace padding-left: 2px */
            }

            /* ---------- Carte du formulaire ---------- */
            .panel {
                background: var(--card);
                border: 1px solid var(--line);
                border-radius: 14px;
                padding: 28px 26px 26px;
            }

            .alert {
                display: flex;
                gap: 10px;
                align-items: baseline;
                padding: 11px 14px;
                margin-bottom: 20px;
                background: var(--alert-wash);
                border: 1px solid var(--alert-line);
                border-radius: 8px;
                font-size: 13px;
                line-height: 1.55;
                color: var(--alert);
            }

            .alert-tag {
                font-family: var(--mono);
                font-size: 10px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                flex-shrink: 0;
                opacity: 0.8;
            }

            .field {
                margin-bottom: 17px;
            }

            label {
                display: block;
                font-size: 12.5px;
                font-weight: 500;
                letter-spacing: -0.005em;
                color: var(--ink);
                margin-bottom: 7px;
            }

            input {
                width: 100%;
                padding: 11px 14px;
                background: var(--paper);
                border: 1px solid var(--line);
                border-radius: 9px;
                color: var(--ink);
                font-family: var(--body);
                font-size: 14.5px;
                transition: background 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
            }

                input::placeholder {
                    color: var(--muted);
                    opacity: 0.65;
                }

                input:focus {
                    outline: none;
                    background: var(--card);
                    border-color: var(--accent);
                    box-shadow: 0 0 0 3px var(--accent-ring);
                }

            button[type='submit'] {
                width: 100%;
                margin-top: 10px;
                padding: 12px;
                background: var(--accent);
                color: var(--on-accent);
                border: none;
                border-radius: 9px;
                font-family: var(--body);
                font-size: 14.5px;
                font-weight: 500;
                letter-spacing: -0.005em;
                cursor: pointer;
                transition: background 140ms ease;
            }

                button[type='submit']:hover {
                    background: var(--accent-deep);
                }

            button:focus-visible,
            input:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 2px;
            }

            /* ---------- Pied ---------- */
            .foot {
                padding: 16px 26px;
                font-family: var(--mono);
                font-size: 10.5px;
                letter-spacing: 0.06em;
                color: var(--muted);
                text-align: center;
            }

            /* ---------- Apparition ---------- */
            .step {
                opacity: 0;
                transform: translateY(6px);
                animation: rise 460ms cubic-bezier(0.22, 0.68, 0.35, 1) forwards;
            }

                .step:nth-child(1) {
                    animation-delay: 50ms;
                }

                .step:nth-child(2) {
                    animation-delay: 120ms;
                }

            @@keyframes rise {
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (max-width: 480px) {
                .bar {
                    padding: 16px 18px;
                }

                .stage {
                    padding: 20px 18px 48px;
                }

                h1 {
                    font-size: 33px;
                    margin-bottom: 22px;
                }

                .panel {
                    padding: 24px 20px 22px;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                *, *::before {
                    transition: none !important;
                    animation: none !important;
                }

                .step {
                    opacity: 1;
                    transform: none;
                }
            }
    </style>
</head>
<body>

    <header class="bar">
        <div class="logotype">S<em>so</em></div>

        <button class="theme" type="button" id="themeToggle"
                aria-label="Basculer le thème sombre" aria-pressed="false">
            <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.2" />
                <path d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.4 5.4l1.4 1.4M17.2 17.2l1.4 1.4M18.6 5.4l-1.4 1.4M6.8 17.2l-1.4 1.4" />
            </svg>
            <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a6.9 6.9 0 0 0 10.8 10.8z" />
            </svg>
        </button>
    </header>

    <div class="stage">
        <main class="record">

            <h1 class="step">Confirmez votre identité</h1>

            <div class="panel step">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert" role="alert">
                        <span class="alert-tag">Refusé</span>
                        <span>@Model.ErrorMessage</span>
                    </div>
                }

                <form method="post">
                    <div class="field">
                        <label asp-for="Email">Adresse électronique</label>
                        <input asp-for="Email" type="email"
                               placeholder="prenom.nom@@entreprise.com"
                               autocomplete="username" autofocus />
                    </div>

                    <div class="field">
                        <label asp-for="Password">Mot de passe</label>
                        <input asp-for="Password" type="password"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                    </div>

                    <button type="submit">Confirmer mon identité</button>
                </form>
            </div>

        </main>
    </div>

    <footer class="foot">
        Authorization Code + PKCE
    </footer>

    <script>
            (function() {
                var root = document.documentElement;
                var btn = document.getElementById('themeToggle');

                function sync() {
                    btn.setAttribute('aria-pressed',
                        root.getAttribute('data-theme') === 'dark' ? 'true' : 'false');
                }

                btn.addEventListener('click', function() {
                    var dark = root.getAttribute('data-theme') === 'dark';
                    if (dark) root.removeAttribute('data-theme');
                    else root.setAttribute('data-theme', 'dark');
                    try { localStorage.setItem('sso-theme', dark ? 'light' : 'dark'); } catch (e) { }
                    sync();
                });

                sync();
            })();
    </script>

</body>
</html>
