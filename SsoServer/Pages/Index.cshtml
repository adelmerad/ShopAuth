@page
@model SsoServer.Pages.IndexModel
@{
    Layout = null;

    var connected = User.Identity?.IsAuthenticated == true;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sso — serveur d'identité</title>

    <script>
            (function () {
                try {
                    var saved = localStorage.getItem('sso-theme');
                    var dark = saved
                        ? saved === 'dark'
                        : window.matchMedia('(prefers-color-scheme: dark)').matches;
                    if (dark) document.documentElement.setAttribute('data-theme', 'dark');
                } catch (e) { }
            })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style>
            :root {
                --paper: #F3F6F5;
                --card: #FFFFFF;
                --sunken: #EDF2F1;
                --ink: #10231F;
                --ink-soft: #47605B;
                --muted: #7B8D89;
                --line: #DDE5E3;
                --line-soft: #E9EFEE;
                --accent: #0E7C7B;
                --accent-deep: #0A5654;
                --accent-wash: #E5F1F0;
                --ok: #0F7B4F;
                --ok-wash: #E7F3ED;
                --hover: #ECF1F0;
                --on-accent: #FFFFFF;

                --display: 'Newsreader', Georgia, serif;
                --body: 'Inter', system-ui, -apple-system, sans-serif;
                --mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;

                color-scheme: light;
            }

            html[data-theme='dark'] {
                --paper: #0C1513;
                --card: #131F1D;
                --sunken: #0F1917;
                --ink: #E3EDEA;
                --ink-soft: #9FB3AE;
                --muted: #728682;
                --line: #24322F;
                --line-soft: #1B2725;
                --accent: #2FA8A3;
                --accent-deep: #46BDB7;
                --accent-wash: rgba(47, 168, 163, 0.12);
                --ok: #5FC095;
                --ok-wash: rgba(95, 192, 149, 0.12);
                --hover: #1A2A27;
                --on-accent: #071110;

                color-scheme: dark;
            }

            * { box-sizing: border-box; }

            html { background: var(--paper); }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                background: var(--paper);
                color: var(--ink);
                font-family: var(--body);
                font-size: 14px;
                line-height: 1.5;
                -webkit-font-smoothing: antialiased;
                transition: background 220ms ease, color 220ms ease;
            }

            a { color: inherit; }

            /* ---------- En-tête ---------- */
            .bar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding: 18px 26px;
            }

            .logotype {
                font-family: var(--display);
                font-size: 23px;
                font-weight: 500;
                letter-spacing: -0.015em;
                line-height: 1;
                user-select: none;
                text-decoration: none;
            }
            .logotype em { font-style: normal; color: var(--accent); }

            .bar-right { display: flex; align-items: center; gap: 10px; }

            .session {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 5px 11px;
                border-radius: 999px;
                background: var(--ok-wash);
                color: var(--ok);
                font-size: 12px;
                font-weight: 500;
            }
            .session::before {
                content: '';
                width: 6px; height: 6px;
                border-radius: 50%;
                background: currentColor;
            }

            .theme {
                display: grid;
                place-items: center;
                width: 34px; height: 34px;
                border: 1px solid var(--line);
                border-radius: 9px;
                background: var(--card);
                color: var(--ink-soft);
                cursor: pointer;
                transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
            }
            .theme:hover { background: var(--hover); color: var(--ink); border-color: var(--muted); }
            .theme svg { display: block; }

            .logout-btn {
                display: inline-flex;
                align-items: center;
                height: 34px;
                padding: 0 14px;
                border: 1px solid var(--line);
                border-radius: 9px;
                background: var(--card);
                color: var(--ink-soft);
                font-family: var(--body);
                font-size: 12.5px;
                font-weight: 500;
                cursor: pointer;
                transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
            }
            .logout-btn:hover { background: var(--hover); color: var(--ink); border-color: var(--muted); }
            .theme .moon { display: none; }
            html[data-theme='dark'] .theme .sun { display: none; }
            html[data-theme='dark'] .theme .moon { display: block; }

            /* ---------- Contenu ---------- */
            .stage {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 46px 24px 70px;
                text-align: center;
            }

            .column { width: 100%; max-width: 640px; }

            h1 {
                font-family: var(--display);
                font-size: 44px;
                line-height: 1.05;
                letter-spacing: -0.025em;
                font-weight: 400;
                margin: 0 0 14px;
            }

            .lede {
                font-size: 15px;
                line-height: 1.65;
                color: var(--ink-soft);
                margin: 0 auto;
                max-width: 52ch;
            }

            /* ---------- Pied ---------- */
            .foot {
                padding: 16px 26px;
                border-top: 1px solid var(--line-soft);
                font-family: var(--mono);
                font-size: 10.5px;
                letter-spacing: 0.06em;
                color: var(--muted);
                text-align: center;
            }

            /* ---------- Apparition ---------- */
            .step {
                opacity: 0;
                transform: translateY(7px);
                animation: rise 480ms cubic-bezier(0.22, 0.68, 0.35, 1) forwards;
            }
            .step:nth-child(1) { animation-delay: 40ms; }
            .step:nth-child(2) { animation-delay: 100ms; }
            .step:nth-child(3) { animation-delay: 160ms; }
            .step:nth-child(4) { animation-delay: 220ms; }
            .step:nth-child(5) { animation-delay: 280ms; }
            .step:nth-child(6) { animation-delay: 340ms; }

            @@keyframes rise {
                to { opacity: 1; transform: translateY(0); }
            }

            @@media (max-width: 620px) {
                .bar { padding: 16px 18px; }
                .stage { padding: 30px 18px 50px; }
                h1 { font-size: 33px; }
            }

            @@media (prefers-reduced-motion: reduce) {
                *, *::before { transition: none !important; animation: none !important; }
                .step { opacity: 1; transform: none; }
            }
    </style>
</head>
<body>

    <header class="bar">
        <a class="logotype" href="/">S<em>so</em></a>

        <div class="bar-right">
            @if (connected)
            {
                <span class="session">@User.Identity!.Name</span>
                <form method="post" asp-page-handler="Logout">
                    <button class="logout-btn" type="submit">Se déconnecter</button>
                </form>
            }

            <button class="theme" type="button" id="themeToggle"
                    aria-label="Basculer le thème sombre" aria-pressed="false">
                <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="4.2" />
                    <path d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.4 5.4l1.4 1.4M17.2 17.2l1.4 1.4M18.6 5.4l-1.4 1.4M6.8 17.2l-1.4 1.4" />
                </svg>
                <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a6.9 6.9 0 0 0 10.8 10.8z" />
                </svg>
            </button>
        </div>
    </header>

    <div class="stage">
        <main class="column">

            <h1 class="step">Serveur d'identité</h1>

            <p class="lede step">
                Les applications de l'entreprise délèguent leur connexion à ce
                serveur. Un employé s'identifie une seule fois, et les autres
                applications le reconnaissent sans nouvelle saisie. Aucune d'elles
                ne voit son mot de passe.
            </p>

        </main>
    </div>

    <footer class="foot">
        OpenID Connect · Authorization Code + PKCE
    </footer>

    <script>
            (function () {
                var root = document.documentElement;
                var btn = document.getElementById('themeToggle');

                function sync() {
                    btn.setAttribute('aria-pressed',
                        root.getAttribute('data-theme') === 'dark' ? 'true' : 'false');
                }

                btn.addEventListener('click', function () {
                    var dark = root.getAttribute('data-theme') === 'dark';
                    if (dark) root.removeAttribute('data-theme');
                    else root.setAttribute('data-theme', 'dark');
                    try { localStorage.setItem('sso-theme', dark ? 'light' : 'dark'); } catch (e) { }
                    sync();

                });

                sync();
            })();
    </script>

</body>
</html>
